# Names only — never commit a real value.
# VITE_CHAT_API_URL is the public HTTPS URL of the deployed Vercel proxy,
# e.g. https://your-proxy.vercel.app (no trailing slash). GitHub Pages sets it
# from the VITE_CHAT_API_URL repository *variable* during the build.
VITE_CHAT_API_URL=

# DIFY_API_KEY lives ONLY in Vercel's secret store for the proxy deployment.
# It is never set in this repo, in the Pages workflow, or in the frontend.
DIFY_API_KEY=
